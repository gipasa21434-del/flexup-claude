// Shared build settings for FLEX UP.
// Secrets are NOT stored here. Copy Config/Secrets.example.xcconfig to Config/Secrets.xcconfig
// (git-ignored) or let CI generate it from GitHub Actions Secrets.

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Change to your own reverse-DNS id before signing (must match the provisioning profile).
FLEXUP_BUNDLE_ID = app.flexup.ios
FLEXUP_TEAM_ID =

// Supabase: host only, without https:// (xcconfig treats "//" as a comment start).
SUPABASE_HOST =
SUPABASE_ANON_KEY =
// "auto" = Supabase when configured, otherwise demo. "demo" forces demo mode.
FLEXUP_BACKEND_MODE = auto

#include? "Secrets.xcconfig"
