# Copy to .env (git-ignored) for local scripts, and add the same names as GitHub Actions Secrets.
# Nothing here is required for DEMO mode — the app runs fully offline without any keys.

# --- Supabase (optional: enables the real backend) ---
SUPABASE_HOST=your-project-ref.supabase.co      # host only, no https://
SUPABASE_ANON_KEY=                               # public anon key (RLS protects data)

# --- Apple code signing (optional: enables the signed IPA job) ---
IOS_TEAM_ID=                     # 10-char Team ID from developer.apple.com → Membership
IOS_BUNDLE_ID=                   # e.g. com.yourname.flexup (must match the provisioning profile)
IOS_P12_BASE64=                  # base64 of the exported distribution/development certificate (.p12)
IOS_P12_PASSWORD=                # password set when exporting the .p12
IOS_PROVISION_PROFILE_BASE64=    # base64 of the .mobileprovision (ad-hoc / development / app-store)
IOS_EXPORT_METHOD=ad-hoc         # ad-hoc | development | app-store
KEYCHAIN_PASSWORD=               # optional, random if empty

# --- TestFlight upload (optional, only for app-store method) ---
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_P8_BASE64=
